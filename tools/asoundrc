defaults.pcm.card 1
defaults.pcm.device 0
defaults.ctl.card 1
# Общий микшер для звуковой платы WM8960.
#
# Зачем: по выходу одновременно должны идти два потока — звук CarPlay и
# бесконечная тишина, которая не даёт кодеку заснуть. Без тишины радио BM54
# теряет вход AUX, потому что определяет источник по нагрузке, а выключенный
# выходной каскад нагрузки не создаёт.
#
# Прямое обращение к hw: эксклюзивно, поэтому нужен dmix. А он на этой карте
# принимает только 32 бита, поэтому поверх ставим plug для преобразования.
#
# Ставится как ~/.asoundrc

pcm.carplay {
    type plug
    slave.pcm "obshchiy"
}

pcm.obshchiy {
    type dmix
    ipc_key 2026
    slave {
        pcm "hw:wm8960soundcard,0"
        format S32_LE
        rate 44100
        channels 2
    }
}
