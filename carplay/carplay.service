[Unit]
# Процесс CarPlay. Живёт постоянно, с загрузки.
#
# Запускать его «при подключении телефона» не нужно и невозможно: донгл виден
# системе всегда, а телефон появляется и пропадает уже внутри работающего
# сеанса. Поэтому служба просто всегда работает, а на появление телефона
# реагирует сама; при отключении телефона окно сохраняется.
#
# Это пользовательская служба, а не системная: ей нужен графический сеанс,
# потому что картинка показывается через ffplay в том же X, что выводится
# на композит.
#
# Установка:
#   mkdir -p ~/.config/systemd/user
#   cp ~/carplay/carplay.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now carplay.service
#
# Отступы по краям картинки подбираются в ~/.carplay, образец лежит рядом
# в carplay/nastroyki. После правки: systemctl --user restart carplay
#
# Чтобы служба поднималась и без входа в графический сеанс:
#   loginctl enable-linger ilgiz
#
# Посмотреть, что происходит:
#   journalctl --user -u carplay -f

Description=CarPlay через донгл Carlinkit
# Не вешаем на graphical-session.target: на Raspberry Pi OS с lightdm эта цель
# никогда не активируется, хотя X работает и пользователь залогинен. Служба
# при этом остаётся enabled, но после перезагрузки не стартует — выглядит так,
# будто автозапуск просто не работает. Проверено 30.09.2026.

StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/carplay
# Без этих двух переменных ffplay не знает, куда рисовать: служба запускается
# не из графического сеанса и его окружения не наследует. Снаружи это выглядит
# так, будто картинки просто нет, хотя звук идёт и сокет работает.
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# Отступы по краям картинки. Файла может не быть — тогда полей нет.
EnvironmentFile=-%h/.carplay
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=2
# Донгл сбрасывается сам, пока с ним не начали разговаривать, и первые
# попытки рукопожатия могут не удаться. Это нормальная работа, а не сбой,
# поэтому службу не надо считать «слишком часто падающей».

[Install]
WantedBy=default.target
