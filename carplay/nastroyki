# Отступы по краям картинки, в процентах от стороны. Ставится как ~/.carplay
#
# Композитный тракт обрезает края — это оверскан, наследие кинескопов, и на
# каждом мониторе он свой. На машине владельца режет сверху и слева, поэтому
# картинку надо подвинуть вправо и вниз, добавив чёрные поля с тех сторон,
# которые режутся.
#
# Подбирается глазами: правите, перезапускаете службу, смотрите на монитор.
#   systemctl --user restart carplay
#
# Ноль везде — картинка во весь кадр, как приходит от донгла.

POLYA_SLEVA=0
POLYA_SPRAVA=0
POLYA_SVERHU=0
POLYA_SNIZU=0
